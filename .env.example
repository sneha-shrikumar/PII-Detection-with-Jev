# Copy to .env and fill in the keys. .env is git-ignored.
# Keys already set in your environment (or, on Windows, your user environment) take priority.

# Jev (TypeSafe): screens every chat
TYPESAFE_API_KEY=your-typesafe-api-key-here

# Claude Haiku 4.5 through OpenRouter: extracts the PII from flagged chats
OPENROUTER_API_KEY=your-openrouter-api-key-here

# LangSmith tracing (optional; run with --no-trace to skip it)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pii-detection-with-jev
# US region is the default. For the EU region use https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
